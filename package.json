{
  "name": "brifle-business",
  "version": "0.4.3",
  "description": "A Desktop App to use Brifle for Business customers",
  "productName": "Brifle Business",
  "author": "Brifle GmbH",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start-dev": "electron-vite dev",
    "test:unit:ui": "vitest --ui",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build:linux": "electron-vite build && electron-builder --linux --publish never",
    "build:win": "electron-vite build && electron-builder --win --publish never",
    "build:mac": "electron-vite build && electron-builder --mac --publish never",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@brifle/brifle-sdk": "^0.3.3",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@openvue/themes": "^1.1.1",
    "@vueuse/core": "^14.2.0",
    "argon2": "^0.44.0",
    "axios": "^1.2.1",
    "bonjour": "^3.5.1",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "dateformat": "^5.0.3",
    "dotenv": "^16.1.4",
    "electron-updater": "^6.6.2",
    "hotkeys-js": "^4.0.2",
    "ipp": "^2.0.1",
    "lucide-vue-next": "^1.0.0",
    "monaco-editor": "^0.55.1",
    "openvue": "^1.1.1",
    "p-retry": "^7.1.1",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^3.0.1",
    "qrcode": "^1.5.3",
    "ssh2-sftp-client": "^12.0.0",
    "tesseract.js": "^6.0.1",
    "vue": "^3.4.18",
    "vue-i18n": "^11.0.0",
    "vue-pdf-embed": "^2.1.3",
    "vue-router": "^4.0.12",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bonjour": "^3.5.13",
    "@types/dateformat": "^5.0.3",
    "@types/ipp": "^2.0.5",
    "@types/node": "^20.5.9",
    "@types/ssh2-sftp-client": "^9.0.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/ui": "^3.2.7",
    "@vue/devtools": "^7.7.2",
    "@vue/eslint-config-typescript": "^14.4.0",
    "@vue/test-utils": "^2.4.4",
    "electron": "^35.1.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.5.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brifle-de/mitarbeiter-desktop-app.git"
  },
  "main": "./out/main/electron-main.js"
}
